# ============前端环境变量============
# 变量必须以 VITE_ 开头才能在代码中访问

# 背景图片 URL（可选）
VITE_BG_URL=

# API 地址（可选，默认为当前域名）
VITE_API_URL=

# ============后端环境变量（EdgeOne Pages 控制台配置）============
# VAPID 密钥可通过 pnpm run generate-vapid 生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EMAIL=admin@magicpush.com

# 推送 API 认证令牌（不设置则关闭认证）
PUSH_TOKEN=

# 用户白名单（逗号分隔，不设置则允许任何人订阅）
ALLOWED_USERS=

# 访问kv函数的token
KV_API_KEY=
